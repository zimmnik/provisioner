Vagrant.configure("2") do |config|

  config.vm.define "fedora", autostart: true, primary: true do |fedora|
    fedora.vm.box = "fedora/45-upstream"
    fedora.vm.box_url = "https://download.fedoraproject.org/pub/fedora/linux/releases/45/Cloud/x86_64/images/Fedora-Cloud-Base-Vagrant-libvirt-45-1.4.x86_64.vagrant.libvirt.box"
    fedora.vm.provider :libvirt do |lv|
      lv.title = 'fedora'
      lv.machine_virtual_size = 16
    end
  end

  config.vm.define "oracle", autostart: false do |oracle|
    oracle.vm.box = "oraclelinux/10-btrfs"
    oracle.vm.box_url = "https://oracle.github.io/vagrant-projects/boxes/oraclelinux/10-btrfs.json"
    oracle.vm.provider :libvirt do |lv|
      lv.title = 'oracle'
    end
  end

  config.vm.provider :libvirt do |lv|
    lv.cpus = 4
    lv.memory = 4096
    lv.video_type = 'virtio'
    lv.graphics_type = 'spice'
    lv.default_prefix = ''
    lv.qemu_use_session = false
  end

  config.vm.synced_folder "../ansible", "/vagrant", type: "rsync"

  config.vm.provision "grow up root", before: :all, type: "shell",
    privileged: true,
    inline: <<-SHELL
      source /etc/os-release
      if [[ "${NAME}" = "Fedora Linux)" ]]; then
        echo -e "resizepart\nFix\n3\nYes\n100%\nprint free\nquit" | parted /dev/vda ---pretend-input-tty
        btrfs fi resize 1:max /
        btrfs fi show /
      fi
    SHELL

  config.vm.provision "update packages", type: "shell", reboot: true, privileged: true,
    inline: <<-SHELL
      # set -a; source /vagrant/http_proxy_env_variable; set +a;
      dnf config-manager setopt fedora-cisco-openh264.enabled=0
      dnf --assumeyes --quiet update
    SHELL

  config.vm.provision "deploy DE", type: "shell", privileged: false,
    inline: <<-SHELL
      set -e
      set -x
      cd /vagrant
      source /etc/os-release
      case "${NAME}" in
      "Fedora Linux")
        :
        ;;
      "Oracle Linux Server")
        :
        ;;
      *)
        echo "Error, unsupported os"
        exit 1
        ;;
      esac
        sudo dnf -y install git python3-libdnf
        python3 -m venv --upgrade-deps .venv && source .venv/bin/activate
        python --version
      pip install --requirement pip_requirements.txt
        pip list --format freeze
        ansible-lint --version
      export ANSIBLE_CONFIG=ansible.cfg
      ansible-galaxy install --role-file galaxy_requirements.yml
        ansible-galaxy collection list --format yaml
        ansible-lint
        ansible-inventory --graph --vars
      ansible-playbook deploy.yml
      # ansible-playbook deploy.yml --tags basic
    SHELL
end
